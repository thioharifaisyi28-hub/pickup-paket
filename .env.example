# =========================================================================
# APPLICATION ENVIRONMENT CONFIGURATION
# PT. Polo Sport Indonesia - Sistem Logistik & Pickup Paket
# Salin file ini ke: secure_app/.env
# =========================================================================

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pickup_skripsi_db
DB_USERNAME=root
DB_PASSWORD=

# Application Settings
APP_NAME="PT. Polo Sport Indonesia - Pickup Paket"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/pickup-paket/public_html
APP_TIMEZONE=Asia/Jakarta

# Session Hardening & Security
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

# Cryptography Specification
INTEGRITY_ALGORITHM=POLO-SHA256-V1
